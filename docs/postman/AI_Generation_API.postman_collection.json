    {
      "name": "18. AI Smart Categorization",
      "item": [
        {
          "name": "18.1 Suggest Category & Material",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "admin-token={{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"22K Gold Kundan Choker Necklace\",\n  \"description\": \"Handcrafted traditional choker with kundan stones and meenakari work\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/ai/suggest-category",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "ai", "suggest-category"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has suggested_category', () => pm.expect(json.data).to.have.property('suggested_category'));",
                  "pm.test('Has suggested_material', () => pm.expect(json.data).to.have.property('suggested_material'));",
                  "pm.test('Has confidence', () => pm.expect(json.data.confidence).to.be.a('number'));",
                  "pm.test('Has tags', () => pm.expect(json.data.tags).to.be.an('array'));"
                ]
              }
            }
          ]
        },
