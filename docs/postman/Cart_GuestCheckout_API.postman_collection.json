            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart"
              ]
            },
            "description": "Attempt to add a non-existent product. Should return 404."
          }
        },
        {
          "name": "8.5 Get Cart (With Items)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cart has items with product details', function () {",
                  "    const json = pm.response.json();",
                  "    const items = json.data.cart_items;",
                  "    pm.expect(items.length).to.be.at.least(1);",
                  "    pm.expect(items[0].products).to.have.property('name');",
                  "    pm.expect(items[0].products).to.have.property('price');",
                  "    pm.expect(items[0].products).to.have.property('product_images');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/customer/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart"
              ]
            },
            "description": "Get the cart after adding items. Should include product details and images."
          }
        },
        {
          "name": "8.6 Update Cart Item Quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
