              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": ""
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart"
              ]
            },
            "description": "Attempt to access cart without authentication. Should return 401."
          }
        }
      ]
    },
    {
      "name": "9. Guest Checkout",
      "description": "Guest checkout signup flow. Creates account, syncs cart, sets JWT cookie.",
      "item": [
        {
          "name": "9.1 Guest Checkout Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has customer and cart', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('customer');",
                  "    pm.expect(json.data).to.have.property('cart');",
                  "    pm.expect(json.data.customer).to.have.property('id');",
                  "    pm.expect(json.message).to.include('Account created');",
                  "});",
                  "",
                  "pm.test('JWT cookie is set', function () {",
                  "    const cookie = pm.response.headers.get('Set-Cookie');",
                  "    pm.expect(cookie).to.include('customer-token');",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.customer) {",
                  "    pm.globals.set('guest_customer_id', json.data.customer.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guestcheckout_{{$timestamp}}@example.com\",\n  \"full_name\": \"Guest Customer\",\n  \"phone\": \"+91 1234567890\",\n  \"items\": [\n    { \"product_id\": \"{{product_id}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/guest-checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "guest-checkout"
              ]
            },
            "description": "Guest checkout: creates account with random password, syncs cart, sets JWT cookie, sends password reset email."
          }
        },
        {
          "name": "9.2 Guest Checkout — Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Returns duplicate error', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error).to.include('already exists');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testcustomer@example.com\",\n  \"items\": [\n    { \"product_id\": \"{{product_id}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/guest-checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "guest-checkout"
              ]
            },
            "description": "Attempt guest checkout with existing email. Should return 409."
          }
        },
        {
          "name": "9.3 Guest Checkout — Validation Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Returns validation details', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error');",
                  "    pm.expect(json).to.have.property('details');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"items\": \"not-an-array\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/guest-checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "guest-checkout"
              ]
            },
            "description": "Verifies that invalid input returns 400 with details."
          }
