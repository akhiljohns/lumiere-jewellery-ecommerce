{
  "info": {
    "name": "Jewellery API — Cart & Guest Checkout",
    "description": "New endpoints for TASK-A03. Import into existing Jewellery workspace.\n\nRequires the same global variables (base_url, product_id) and an active customer-token cookie from folder 7.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "event": [],
  "item": [
    {
      "name": "8. Cart",
      "description": "Cart CRUD operations. Requires a logged-in customer (customer-token cookie set). Uses product_id from Products section.",
      "item": [
        {
          "name": "8.1 Get Cart (Empty)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cart has cart_items array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('cart_items');",
                  "    pm.expect(json.data.cart_items).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/customer/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart"
              ]
            },
            "description": "Get the current customer cart. Should be empty initially."
          }
        },
        {
          "name": "8.2 Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Cart contains the added item', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.cart_items.length).to.be.at.least(1);",
                  "    pm.expect(json.message).to.eql('Item added to cart');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart"
              ]
            },
            "description": "Add a product to the cart with quantity 2."
          }
        },
        {
          "name": "8.3 Add Item — Validation Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Returns validation details', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error');",
                  "    pm.expect(json).to.have.property('details');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"not-a-uuid\",\n  \"quantity\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart"
              ]
            },
            "description": "Verifies that invalid input returns 400 with details."
          }
        },
        {
          "name": "8.4 Add Item — Product Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
