            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/cart/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart",
                "{{product_id}}"
              ]
            },
            "description": "Update the quantity of a cart item to 3."
          }
        },
        {
          "name": "8.7 Remove Cart Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Item removed', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.eql('Item removed from cart');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/customer/cart/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart",
                "{{product_id}}"
              ]
            },
            "description": "Remove a specific product from the cart."
          }
        },
        {
          "name": "8.8 Sync Cart (Merge)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cart synced with items', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.cart_items.length).to.be.at.least(1);",
                  "    pm.expect(json.message).to.eql('Cart synced successfully');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"product_id\": \"{{product_id}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/cart/sync",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart",
                "sync"
              ]
            },
            "description": "Sync localStorage items to the server cart (merge strategy: max quantity)."
          }
        },
        {
          "name": "8.9 Sync Cart — Empty Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Sync with empty items works', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('cart_items');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/cart/sync",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart",
                "sync"
              ]
            },
            "description": "Sync with empty items array. Should just return current server cart."
          }
        },
        {
          "name": "8.10 Validate Cart for Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Validation returns cart and warnings', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('cart_items');",
                  "    pm.expect(json).to.have.property('warnings');",
                  "    pm.expect(json).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/customer/cart/validate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart",
                "validate"
              ]
            },
            "description": "Pre-checkout validation. Removes inactive/out-of-stock items and clamps quantities."
          }
        },
        {
          "name": "8.11 Clear Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cart is cleared', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.cart_items).to.be.an('array').that.is.empty;",
                  "    pm.expect(json.message).to.eql('Cart cleared');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/customer/cart/clear",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "cart",
                "clear"
              ]
            },
            "description": "Clear all items from the cart."
          }
        },
        {
          "name": "8.12 Cart — No Auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Returns auth error', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error).to.include('Authentication');",
