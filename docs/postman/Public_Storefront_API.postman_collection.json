{
  "info": {
    "name": "Public Storefront API",
    "description": "Public API endpoints for the jewellery e-commerce storefront. No authentication required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "13. Public Products",
      "item": [
        {
          "name": "13.1 List Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "created_at", "disabled": true },
                { "key": "order", "value": "desc", "disabled": true },
                { "key": "category_slug", "value": "", "disabled": true },
                { "key": "material", "value": "", "disabled": true },
                { "key": "min_price", "value": "", "disabled": true },
                { "key": "max_price", "value": "", "disabled": true },
                { "key": "is_featured", "value": "true", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                  "pm.test('Has pagination', () => pm.expect(json.pagination).to.have.property('total'));",
                  "if (json.data.length > 0) {",
                  "  pm.globals.set('product_slug', json.data[0].slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "13.2 Filter by Category Slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products?category_slug={{category_slug}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "category_slug", "value": "{{category_slug}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "13.3 Filter by Price Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products?min_price=1000&max_price=50000",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "min_price", "value": "1000" },
                { "key": "max_price", "value": "50000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "13.4 Sort by Price (Low to High)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products?sort=price&order=asc",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "sort", "value": "price" },
                { "key": "order", "value": "asc" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "13.5 Get Product by Slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/{{product_slug}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_slug}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has product data', () => pm.expect(json.data).to.have.property('id'));",
                  "pm.test('Has related products', () => pm.expect(json.related).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "13.6 Featured Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/featured?limit=8",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "featured"],
              "query": [
                { "key": "limit", "value": "8" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "14. Public Categories",
      "item": [
        {
          "name": "14.1 List Categories with Product Counts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                  "if (json.data.length > 0) {",
                  "  pm.test('Has product_count', () => pm.expect(json.data[0]).to.have.property('product_count'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "15. Product Search",
      "item": [
        {
          "name": "15.1 Full-Text Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/search?query=gold ring",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "search"],
              "query": [
                { "key": "query", "value": "gold ring" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                  "pm.test('Has pagination', () => pm.expect(json.pagination).to.have.property('total'));"
                ]
              }
            }
          ]
        },
        {
          "name": "15.2 Search with Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/search?query=necklace&min_price=5000&max_price=100000",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "search"],
              "query": [
                { "key": "query", "value": "necklace" },
                { "key": "min_price", "value": "5000" },
                { "key": "max_price", "value": "100000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "15.3 Search with Category Filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/search?query=diamond&category_id={{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "search"],
              "query": [
                { "key": "query", "value": "diamond" },
                { "key": "category_id", "value": "{{category_id}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "15.4 Search — Empty Query (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products/search",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "search"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "16. Admin Search",
      "item": [
        {
          "name": "16.1 Search Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "admin-token={{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/search?query=gold&type=products",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "search"],
              "query": [
                { "key": "query", "value": "gold" },
                { "key": "type", "value": "products" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));",
                  "pm.test('Type is products', () => pm.expect(json.type).to.equal('products'));"
                ]
              }
            }
          ]
        },
        {
          "name": "16.2 Search Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "admin-token={{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/search?query=admin&type=users",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "search"],
              "query": [
                { "key": "query", "value": "admin" },
                { "key": "type", "value": "users" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Type is users', () => pm.response.json().type === 'users');"
                ]
              }
            }
          ]
        },
        {
          "name": "16.3 Search Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "admin-token={{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/search?query=ORD&type=orders",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "search"],
              "query": [
                { "key": "query", "value": "ORD" },
                { "key": "type", "value": "orders" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
